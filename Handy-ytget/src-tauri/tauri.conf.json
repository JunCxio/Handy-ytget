{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Handy-ytget",
  "version": "0.3.2",
  "identifier": "local.ytget.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Handy-ytget · 视频下载",
      "width": 1120,
      "height": 820,
      "minWidth": 860,
      "minHeight": 680,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://i.ytimg.com; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [{
        "identifier": "main-window",
        "windows": ["main"],
        "permissions": ["core:event:allow-listen", "core:event:allow-unlisten"]
      }]
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
